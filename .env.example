# Neon Postgres
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/enkore?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/enkore?sslmode=require"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Payment gateways (test keys during development)
PAYMENT_TEST_MODE=true

PAYFAST_MERCHANT_ID_TEST=
PAYFAST_MERCHANT_KEY_TEST=
PAYFAST_PASSPHRASE_TEST=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE_LIVE=

YOCO_SECRET_KEY_TEST=
YOCO_SECRET_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

KYSHI_SECRET_KEY_TEST=
KYSHI_SECRET_KEY_PROD=
KYSHI_WEBHOOK_SECRET=

# Email (Resend) — EMAIL_FROM must be an address on a domain verified in
# the Resend dashboard (SPF/DKIM records added at the registrar), e.g.
# "ENKORE <hello@enkoremusic.online>". Emails are skipped (logged, not
# thrown) if either var is unset — see src/lib/email/resend.ts.
RESEND_API_KEY=
EMAIL_FROM=

# File uploads (Vercel Blob) — musician dashboard: track audio/cover art,
# profile image, onboarding docs. Get this from the Blob store's settings
# in the Vercel dashboard (Storage tab) once one is created for this
# project. Upload routes 503 gracefully if unset, matching the Payfast
# pattern above — see src/app/api/musician/upload/route.ts.
BLOB_READ_WRITE_TOKEN=

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
